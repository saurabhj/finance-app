<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Copy to ~/Library/LaunchAgents/ and run: launchctl load ~/Library/LaunchAgents/com.family.finance.review-monthly.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.family.finance.review-monthly</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>-c</string><string>cd /Volumes/COMMON/Projects/finance-app &amp;&amp; source venv/bin/activate &amp;&amp; python3 manage.py run_review --cadence monthly</string></array>
  <key>StartCalendarInterval</key><dict><key>Day</key><integer>3</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/tmp/finance.review-monthly.log</string>
  <key>StandardErrorPath</key><string>/tmp/finance.review-monthly.log</string>
</dict>
</plist>
