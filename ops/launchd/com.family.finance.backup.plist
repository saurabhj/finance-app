<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Copy to ~/Library/LaunchAgents/ and run: launchctl load ~/Library/LaunchAgents/com.family.finance.backup.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.family.finance.backup</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>/Volumes/COMMON/Projects/finance-app/ops/backup.sh</string></array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>/tmp/finance-backup.log</string>
  <key>StandardErrorPath</key><string>/tmp/finance-backup.log</string>
</dict>
</plist>
